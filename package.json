  "scripts": {
    "build": "turbo run build",
    "dev": "node tools/dev.mjs",
    "db:dev": "node tools/dev-db.mjs",
    "seed": "cd packages/api && medusa exec ./src/scripts/seed.ts",
    "db:seed": "npm run seed",
    "db:migrate": "cd packages/api && medusa db:migrate",
