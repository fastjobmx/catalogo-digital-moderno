# Copia este archivo a packages/api/.env

# --- Base de datos ---
# `bun run db:dev` levanta este Postgres sin instalar nada. Con Docker: `docker compose up -d`
# y cambia el puerto a 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/catalogo

# Opcional en desarrollo. Necesario con más de una instancia: activa caché, eventos y locks en Redis.
# REDIS_URL=redis://localhost:6379

# --- Medusa / Mercur ---
STORE_CORS=http://localhost:3100
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001,http://localhost:9000
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
JWT_SECRET=cambia-esto-en-produccion
COOKIE_SECRET=cambia-esto-en-produccion
MERCUR_VENDOR_URL=http://localhost:7001

# --- WhatsApp ---
# mock: sandbox. No sale nada a internet; cada mensaje queda en la tabla whatsapp_outbox.
#       Se ve en http://localhost:3100/dev/whatsapp-outbox
# cloud: WhatsApp Cloud API de Meta. Requiere WA_TOKEN y WA_PHONE_ID.
# twilio: Twilio API for WhatsApp.
WHATSAPP_PROVIDER=mock

# Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WA_TOKEN=
WA_PHONE_ID=
WHATSAPP_API_VERSION=v23.0
# Webhook de estados: GET/POST https://TU-DOMINIO/webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Plantillas aprobadas en Meta (texto en docs/whatsapp-plantillas.md)
WHATSAPP_TEMPLATE_VENDOR=pedido_proveedor
WHATSAPP_TEMPLATE_CUSTOMER=pedido_cliente
WHATSAPP_TEMPLATE_LANG=es

# URL pública del backend. Con Twilio activa los estados de entrega (POST /webhooks/twilio).
WHATSAPP_PUBLIC_URL=

# Twilio (solo si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número en formato +57...
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID_VENDOR=
TWILIO_CONTENT_SID_CUSTOMER=

# --- Archivos ---
# Sin S3_BUCKET, los logos se guardan en disco. En producción usa S3 o compatible.
FILE_BACKEND_URL=http://localhost:9000/static
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FILE_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Plataforma ---
# Pedidos por teléfono y hora. En producción usa 5; aquí es alto para repetir verify:e2e.
ORDER_RATE_LIMIT_PER_HOUR=500
# Porcentaje mostrado como comisión en la vista global del admin.
PLATFORM_COMMISSION_PERCENT=3

# --- Fotos del seed (npm run seed:images) ---
# Orden: Pexels, Unsplash, Pixabay, Wikimedia Commons (sin key) y placeholder local.
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Host desde el que se sirven las fotos del seed.
SEED_ASSET_BASE_URL=http://localhost:3100
